{
  "name": "@pigverse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "recovery:inspect": "node --experimental-strip-types scripts/recovery-inspect.mjs",
