{
  "name": "@pigverse/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "build:production": "hardhat compile --build-profile production",
    "deploy:sepolia": "hardhat --network baseSepolia --build-profile production run ignition/deploy-sepolia.ts",
    "simulate:sepolia": "pnpm build:production && node ignition/simulate-sepolia.mjs",
    "test:production": "hardhat test --build-profile production",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "22.20.2",
    "hardhat": "3.16.0",
    "typescript": "6.0.3",
    "viem": "2.47.6"
  }
}
